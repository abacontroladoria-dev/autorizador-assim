# =============================================================================
# Pulsar — frontend/.env.example
#
# Copie para `.env.local` e preencha. `.env.local` NÃO vai para o Git.
#
# Convenção que vale para todo este arquivo:
#
#   NEXT_PUBLIC_*  vai para o bundle do browser. É PÚBLICO — qualquer visitante
#                  lê no devtools. Precisa ser passado como ARG no build do
#                  Docker, porque o valor é assado no JS do cliente.
#
#   sem prefixo    fica só no servidor. É SEGREDO. Deve ser injetado como
#                  variável de RUNTIME no Coolify, nunca como ARG do Dockerfile:
#                  ARG aparece no log de build e no `docker history` da imagem.
#
# O Dockerfile deste projeto passa exatamente cinco ARGs, todos NEXT_PUBLIC_*, e
# nenhum segredo. Manter essa propriedade é o que impede uma chave de vazar pela
# imagem.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — banco, auth e realtime
# -----------------------------------------------------------------------------

# URL do projeto. Também alimenta o `connect-src` do CSP em next.config.ts: se
# estiver errada, o browser bloqueia as chamadas ANTES de saírem da página, e o
# sintoma é "Failed to fetch" sem nenhuma requisição no devtools.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (publishable). Pública por natureza — a proteção real é a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alias da anterior, usado por telas mais antigas. Mesmo valor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SEGREDO. Ignora RLS por completo. Só é usado em rotas de servidor, workers e no
# AgentCredentialsRepository (leitura de colunas de credencial). Runtime-only.
SUPABASE_SERVICE_ROLE_KEY=

# Mesma URL do Supabase, para o código de servidor que não usa o prefixo público.
SUPABASE_URL=https://seu-projeto.supabase.co

# URL pública do app. Usada nos links de e-mail de convite e recuperação de senha.
NEXT_PUBLIC_SITE_URL=https://pulsar.suaclinica.com.br


# -----------------------------------------------------------------------------
# OpenAI — camada de IA da atendente virtual
#
# A chave NÃO mora no banco, de propósito: é uma por instalação, não é
# configurável por tela, e assim não existe uma segunda credencial em texto puro
# no Postgres para proteger.
#
# O MODELO também não mora no banco. A coluna `agent_settings.ai_model_mode`
# guardava 'gpt-4o' e nenhum consumidor OpenAI jamais a leu — o único que existiu
# traduzia aquele valor para modelos Gemini. A migration 20260811100000 removeu a
# coluna. Quem escolhe o modelo é OPENAI_MODEL, e só ele.
#
# Não há fallback: valor ausente ou fora da allowlist faz a chamada falhar com
# mensagem explícita, em vez de escolher outro modelo em silêncio.
# -----------------------------------------------------------------------------

# SEGREDO. Runtime-only no Coolify. Nunca como ARG do Dockerfile.
OPENAI_API_KEY=

# Modelo ativo. Precisa estar na allowlist de
# modules/atendimento/llm/modelo.ts — hoje: gpt-4o-mini, gpt-4o.
# Para liberar outro, acrescente o id lá e o preço em precos.ts (Fase 6):
# teto de gasto calculado com preço errado não é teto.
OPENAI_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# WhatsApp — Meta Cloud API
#
# Ainda NÃO implementado (Fase 5). As variáveis estão documentadas aqui para o
# provisionamento na Meta acontecer em paralelo ao desenvolvimento.
#
# Todas SEGREDO, todas runtime-only.
# -----------------------------------------------------------------------------

# App Secret do App Business. Assina o webhook: o HMAC de X-Hub-Signature-256 é
# calculado sobre o CORPO CRU e comparado com timingSafeEqual.
# WHATSAPP_APP_SECRET=

# Token que você escolhe e repete no painel da Meta. Valida o handshake GET.
# WHATSAPP_VERIFY_TOKEN=

# Token de acesso permanente do App Business.
# WHATSAPP_ACCESS_TOKEN=

# Id do número dedicado da clínica (não é o número em si).
# WHATSAPP_PHONE_NUMBER_ID=

# Segredo compartilhado que autentica os workers de agrupamento e envio,
# chamados pelo pg_cron via pg_net. Sem ele, as rotas de worker ficariam
# acionáveis por qualquer um.
# CENTRAL_WORKER_SECRET=


# -----------------------------------------------------------------------------
# Robô autorizador (integração ASSIM/TiTa)
# -----------------------------------------------------------------------------

# URL do serviço do robô, quando o painel de automação precisa falar com ele.
# WORKER_API_URL=
